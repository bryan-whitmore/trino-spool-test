# Template. Copy to .env and fill in for your cluster.
# .env is gitignored; this file is safe to commit.

TRINO_VERSION=478

# S3 / VASTDB identity used by both the vast catalog and the spooling manager.
S3_ACCESS_KEY=AKIAEXAMPLEKEY000000
S3_SECRET_KEY=wJalrXUtnFEMIexampleSECRETkeyEXAMPLEKEY00
S3_REGION=us-east-1

# Cluster access. S3_ENDPOINT serves metadata; DATA_ENDPOINTS must be raw
# CNode IPs (see RUNBOOK troubleshooting on virtual-host addressing).
S3_ENDPOINT=http://main.your-cluster.example.com
DATA_ENDPOINTS=http://10.0.0.1,http://10.0.0.2,http://10.0.0.3,http://10.0.0.4

# Spool store: must be an S3-protocol path the identity can fully manage.
SPOOL_BUCKET=synthetic-datasets
SPOOL_PREFIX=trino-spooling

# Query under test.
CATALOG=var203
SCHEMA=synthetic-datasets/tables
TABLE=events
ROW_LIMIT=100000
